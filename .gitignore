# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
# ...but docs/build/ is documentation, not build output. The bare `build/` pattern above
# matches it too, which silently swallowed new files there — docs/build/14-PAYPAL-INTEGRATION.md
# was written, `git add`ed, refused, and would have been lost. The 14 pre-existing docs in
# that folder were unaffected because a .gitignore rule can't un-track an already-tracked
# file, which is exactly why this went unnoticed.
!docs/build/
.vercel/
.next/

# env & secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# OS/editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Prisma
apps/api/prisma/migrations/dev.db
apps/api/prisma/dev.db

# test/coverage
coverage/
playwright-report/
test-results/

# misc
*.tsbuildinfo
