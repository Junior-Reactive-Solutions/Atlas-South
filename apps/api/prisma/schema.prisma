// Data model per docs/build/05-ARCHITECTURE-AND-STACK.md §5.
// Retention periods enforced against this schema are defined in
// docs/build/10-LEGAL-CONTENT-PLAN.md §2 — the two must never drift apart.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  new
  contacted
  quoted
  won
  lost
}

model Enquiry {
  id             String        @id @default(cuid())
  fullName       String
  email          String
  phone          String
  serviceId      String?
  propertyType   String?
  urgency        String?
  message        String
  sourcePage     String
  status         EnquiryStatus @default(new)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PageView {
  id         String   @id @default(cuid())
  path       String
  referrer   String?
  sessionId  String
  createdAt  DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model Event {
  id         String   @id @default(cuid())
  type       String
  path       String
  label      String?
  sessionId  String
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  totpSecret         String?
  tokenVersion       Int       @default(0)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())

  auditLogs AdminAuditLog[]
}

model AdminAuditLog {
  id          String    @id @default(cuid())
  adminUserId String?
  admin       AdminUser? @relation(fields: [adminUserId], references: [id])
  event       String // e.g. "login_success", "login_failed", "password_changed"
  ip          String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}
