// Data model per docs/build/05-ARCHITECTURE-AND-STACK.md §5.
// Retention periods enforced against this schema are defined in
// docs/build/10-LEGAL-CONTENT-PLAN.md §2 — the two must never drift apart.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  new
  contacted
  quoted
  won
  lost
}

model Enquiry {
  id             String        @id @default(cuid())
  fullName       String
  email          String
  phone          String
  serviceId      String?
  propertyType   String?
  urgency        String?
  message        String
  sourcePage     String
  status         EnquiryStatus @default(new)
  notes          String?       // internal admin notes; not visible to the enquirer
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PageView {
  id         String   @id @default(cuid())
  path       String
  referrer   String?
  sessionId  String
  createdAt  DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model Event {
  id         String   @id @default(cuid())
  type       String
  path       String
  label      String?
  sessionId  String
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  totpSecret         String?
  tokenVersion       Int       @default(0)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())

  auditLogs AdminAuditLog[]
}

model AdminAuditLog {
  id          String    @id @default(cuid())
  adminUserId String?
  admin       AdminUser? @relation(fields: [adminUserId], references: [id])
  event       String // e.g. "login_success", "login_failed", "password_changed"
  ip          String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

enum ContentPageType {
  service
  industry
  area
  home
  company
  careers
  packages
  /// Client work write-ups. Uses the same draft/published workflow as every other page
  /// type, which matters more here than elsewhere: a case study names a real client and
  /// a real outcome, so it stays in draft until someone has actually verified it.
  caseStudy
  /// Insight/SEO articles at /insights. Unlike every other type above, rows of this type
  /// are created at runtime through the admin panel rather than seeded from code — the
  /// client authors these themselves. Draft until published, for the same reason as
  /// caseStudy: it goes out under the company's name and gets read as its position.
  article
}

enum ContentStatus {
  draft
  published
}

// Admin-editable page content — one row per service/industry/area page plus the
// home page. draftData is always present and is what the admin panel edits;
// publishedData is null until the first Publish action and is the ONLY thing
// the public site ever reads. This split means an in-progress edit can never
// accidentally go live mid-save.
//
// The JSON shape of draftData/publishedData depends on `type` and mirrors the
// props already accepted by the corresponding page template component:
// ServiceDetailPage, IndustryDetailPage, ServiceAreaDetailPage, or the Home
// hero copy. Kept as JSON rather than fully normalised columns because each
// type's shape differs (features/FAQs vs challenges/approach vs coverage) and
// the admin form + public template are the actual source of truth for shape,
// not this table.
model ContentPage {
  id            String          @id @default(cuid())
  slug          String          @unique // matches the page's route id, e.g. "electricals"
  type          ContentPageType
  path          String // e.g. "/hard-services/electricals"
  status        ContentStatus   @default(draft)
  draftData     Json
  publishedData Json?
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([type])
  @@index([status])
}

/// Per-nav-item public visibility, toggled from the admin panel.
///
/// Keyed by nav item id (the `id` field in packages/shared navigation.ts) rather than by
/// ContentPage slug, because several nav entries — the five unbuilt industries — have no
/// ContentPage row at all. One table therefore covers both content-backed pages and
/// nav-only entries instead of two competing mechanisms.
///
/// Absence of a row means visible. Only explicitly hidden items are stored, so the
/// default for anything new is to show, and the table stays small.
model PageVisibility {
  navId     String   @id // matches NavItem.id, e.g. "fire-safety"
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([visible])
}

/// How a chat lead would rather be followed up — captured directly rather than inferred,
/// so the team calls someone who asked to be called instead of emailing them by default.
enum PreferredContact {
  email
  phone
}

/// Leads captured by the on-site chatbot — contact details and the service(s) the visitor
/// expressed interest in. Separate from Enquiry so the two pipelines stay distinct in the
/// admin panel (chatbot = warm lead at top of funnel; enquiry = explicit quote request
/// further down).
///
/// firstName/lastName replaced the original single `name` column (migration
/// 20260826140000_update_chat_lead_fields backfills every existing row by splitting `name`
/// on its first space). company/phone/preferredContact are new fields the chat flow now
/// always asks for, and email became optional — it's only collected when the visitor picks
/// "Email" as their preferredContact. All four are nullable at the DB level because leads
/// captured before this change genuinely don't have company/phone/preferredContact, and
/// there's no honest value to backfill them with; what's actually required for a *new*
/// submission is enforced by the Zod schema in routes/leads.ts, not by a DB constraint that
/// would otherwise have to fabricate data for old rows.
model ChatLead {
  id                String            @id @default(cuid())
  firstName         String
  lastName          String            @default("")
  company           String?
  email             String?
  phone             String?
  preferredContact  PreferredContact?
  services          String   // comma-separated service labels
  message           String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

model JobApplication {
  id                   String   @id @default(cuid())
  fullName             String
  email                String
  phone                String
  roleTitle            String?
  /// Optional free-text note — no longer the primary way to submit a cover letter (an
  /// actual file upload was added 2026-08-31, see coverLetterFileName/Path below); kept as
  /// an "anything else" field on the form.
  coverLetter          String?
  cvFileName           String?
  cvFilePath           String?
  coverLetterFileName  String?
  coverLetterFilePath  String?
  createdAt            DateTime @default(now())

  @@index([createdAt])
  @@index([roleTitle])
}

/// PayPal-billed status, mirroring the subset of PayPal's own subscription statuses this
/// app acts on (PayPal's API also has APPROVAL_PENDING/APPROVED as pre-payment states —
/// this app only ever creates a row once a subscription has been verified server-side as
/// at least ACTIVE, so those two don't need a local equivalent; see routes/paypal.ts).
enum SubscriptionStatus {
  active
  suspended
  cancelled
  expired
}

/// One row per PayPal recurring billing subscription — apps/api/src/lib/paypal.ts and
/// apps/api/src/routes/paypal.ts, per docs/build/14-PAYPAL-INTEGRATION.md.
///
/// This table is a read cache of what PayPal itself already tracks as the source of
/// truth, not a competing ledger — every write to it is preceded by either (a) a
/// server-to-server GET /v1/billing/subscriptions/{id} call that confirms the row's
/// contents against PayPal's own records, or (b) a signature-verified webhook event. The
/// client-supplied tierLabel is a display convenience only; paypalPlanId is what's
/// actually trusted, cross-checked server-side against PACKAGES_CONTENT's known plan ids
/// before a row is ever created (see confirmSubscription in routes/paypal.ts) — this is
/// what stops a tampered client request from recording a cheaper tier than the buyer
/// actually paid for.
model Subscription {
  id                   String             @id @default(cuid())
  paypalSubscriptionId String             @unique // PayPal's "I-XXXXXXXXXXXX" id
  paypalPlanId         String // PayPal's "P-XXXXXXXXXXXX" billing plan id
  tierLabel            String // "Starter" | "Professional" | "Enterprise" — display only
  customerName         String
  customerEmail        String
  status               SubscriptionStatus @default(active)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@index([customerEmail])
}

/// Server-side record of cookie-consent decisions, so the client can evidence consent to
/// the ICO on request. UK GDPR Art. 7(1) puts the burden of demonstrating consent on the
/// controller, and a choice held only in the visitor's own localStorage cannot be produced
/// as evidence — the visitor can clear it, and the operator never had a copy.
///
/// Deliberately minimal, because this log must not become the tracking mechanism the
/// consent system exists to gate:
///   - `consentId` is a random value generated when the visitor answers, stored alongside
///     their choice. It identifies the *decision*, not the person, and is transmitted only
///     at the moment a decision is made — never on page views — so it cannot be used to
///     follow anyone around the site.
///   - No IP address, no user agent, no page path. Storing an IP would make this materially
///     more identifying while adding nothing: the record's job is to show WHAT was chosen,
///     under WHICH policy version, and WHEN.
/// The honest trade-off is that this evidences the decision rather than the individual.
/// That is the correct side to err on for a log covering people who may have refused.
model ConsentLog {
  id        String   @id @default(cuid())
  /// Random per-decision reference, also held in the visitor's consent record.
  consentId String
  /// CONSENT_VERSION the banner was showing — proves which disclosure they answered.
  version   Int
  /// The choice per category, e.g. { "strictly-necessary": true, "analytics": false }.
  choices   Json
  /// When the visitor answered, as reported by their device.
  decidedAt DateTime
  /// When we received it — differs from decidedAt if the request was retried offline.
  createdAt DateTime @default(now())

  @@index([consentId])
  @@index([createdAt])
}

enum SystemEventLevel {
  info
  warning
  error
}

/// Operational and error log for the whole system — API faults, client-side crashes, and
/// notable non-admin events. Surfaced in the admin panel so problems are visible without
/// trawling hosting logs, which on the current plan are short-lived.
///
/// NOT analytics, and deliberately not a way to reinstate tracking for visitors who
/// refused it: entries carry no session id, no consent id, no IP and no visitor identifier
/// of any kind. `path` is recorded because an error is not diagnosable without knowing
/// where it happened, but a path alone identifies a page, not a person, and rows are never
/// correlated into a per-visitor trail. Recording that a page threw an error is ordinary
/// operational necessity (UK GDPR Art. 6(1)(f)) and is what the Cookie Policy describes as
/// the record every site keeps in order to run at all.
model SystemEvent {
  id        String           @id @default(cuid())
  level     SystemEventLevel @default(error)
  /// Where it came from: "api" | "web".
  source    String
  /// Short machine-readable kind, e.g. "unhandled_api_error", "client_render_error".
  event     String
  /// Human-readable summary. Truncated at the boundary before storage.
  message   String
  /// Route or page the fault occurred on. Never a query string — those carry user input.
  path      String?
  /// Extra diagnostic detail (status code, truncated stack). No personal data.
  context   Json?
  createdAt DateTime         @default(now())

  @@index([level, createdAt])
  @@index([createdAt])
}
