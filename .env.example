# === apps/web ===
VITE_API_BASE_URL=http://localhost:9001
VITE_CLOUDINARY_CLOUD_NAME=
VITE_SENTRY_DSN=
VITE_GA4_MEASUREMENT_ID=
# PayPal's public client id — NOT a secret, this is meant to be embedded in browser JS
# (it's what loads https://www.paypal.com/sdk/js). The matching client SECRET only ever
# lives in apps/api's env, never here. Leave blank to keep the site's existing
# "Subscribe" buttons pointing at the quote form instead of rendering PayPal buttons.
VITE_PAYPAL_CLIENT_ID=

# === apps/api ===
NODE_ENV=development
PORT=9001
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
RESEND_API_KEY=
ADMIN_EMAIL=enquiries@atlassouth.co.uk
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=
ADMIN_SEED_EMAIL=
CORS_ALLOWED_ORIGIN=http://localhost:9000
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=100
# PayPal Subscriptions — see docs/build/14-PAYPAL-INTEGRATION.md. PAYPAL_CLIENT_SECRET is
# a real secret: server-side env only, never sent to the browser, never logged.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
# Filled in by scripts/setup-paypal-plans.ts after it creates the three monthly billing
# plans, or supplied directly if the client already has these from their PayPal dashboard.
PAYPAL_PLAN_ID_STARTER=
PAYPAL_PLAN_ID_PROFESSIONAL=
PAYPAL_PLAN_ID_ENTERPRISE=

# See docs/build/05-ARCHITECTURE-AND-STACK.md for the full explanation of each value.
# Never commit a real .env file — only this .env.example template.
